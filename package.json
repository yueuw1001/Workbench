{
  "name": "dsh-workbench",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 侧边栏工作台：问候、账户用量、网页搜索与书签、待办、可自定义分类并拖动整理的应用与会话、自定义背景；侧边栏的热点信息与便签插件保持独立",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "test/*.mjs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT"
}
